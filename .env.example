# NOTE: the deploy workflow (.github/workflows/deploy-cpanel.yml) does
# `cp .env.example .env` and ships the result, so the values here are what
# the deployed backend actually runs with. Local dev overrides live in your
# own uncommitted .env.

APP_NAME=Vendify
APP_ENV=local
APP_KEY=base64:B7u91hhMpdXjCLjIaHT2kjXtIdfA3vxEwc9gQ793sWg=
APP_DEBUG=true
APP_URL=https://test.spurs-developers.com.ng

# ── SPA / CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API with credentials
# (config/cors.php). Add the deployed SPA's origin alongside the dev ones.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Hosts (host[:port], no scheme) whose requests receive cookie-based Sanctum
# auth — needed for the /sanctum/csrf-cookie login handshake.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# cPanel test-server database (what deploys run against).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ruefksxk_vtu_test
DB_USERNAME=ruefksxk_vtu_test
DB_PASSWORD=ruefksxk_vtu_test

# Local development alternative:
# DB_DATABASE=backend
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Amazon SES SMTP. Use an SES SMTP username/password generated in the
# eu-north-1 region. Keep real credentials only in your uncommitted .env.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=email-smtp.eu-north-1.amazonaws.com
MAIL_PORT=587
MAIL_EHLO_DOMAIN=vendify.com.ng
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@vendify.com.ng
MAIL_FROM_NAME="Vendify"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Read by VTUServicesController.
VTU_API_BASE=
VTU_API_TOKEN=

# AI Manager (in-app admin assistant, OpenAI Chat Completions + tool calling).
# OPENAI_API_KEY is required for the assistant to work; the rest have sane
# defaults in config/services.php.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_MAX_TOOL_ITERATIONS=6
OPENAI_TIMEOUT=60
VTU_NG_WEBHOOK_PIN=
